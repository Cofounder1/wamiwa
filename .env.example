# Copy to .env in the project root. Every setting in app/core/config.py can be overridden with a WAMIWA_ prefix.
WAMIWA_ENV=development
WAMIWA_DATABASE_URL=sqlite+aiosqlite:///./wamiwa.db
WAMIWA_PUBLIC_BASE_URL=https://wamiwa.site      # used in links sent by email and SMS
# Production: postgresql+asyncpg://user:password@host:5432/wamiwa
# WAMIWA_REDIS_URL=redis://localhost:6379/0     # required in production (rate limits, OTPs, cache, job locks)
#WAMIWA_JWT_SECRET=change-me-to-at-least-32-random-bytes
#WAMIWA_HASH_PEPPER=change-me
#WAMIWA_PAYMENT_WEBHOOK_SECRET=change-me
#WAMIWA_VOICE_WEBHOOK_SECRET=change-me
#WAMIWA_VIDEO_WEBHOOK_SECRET=change-me
#WAMIWA_RUN_JOBS=true                            # leave on for the worker that runs scheduled jobs
#WAMIWA_SANDBOX_FX_RATE=1500

# --- Web frontend --------------------------------------------------------------------------------
# Sites allowed to call the API from a browser (JSON list). Defaults cover local development and wamiwa.site.
# WAMIWA_CORS_ORIGINS=["http://localhost:5173","https://wamiwa.site"]
# Development only: makes every one-time code this value, so you can click through signup without email.
# Never set it on a shared or live server; the app refuses to start in production with it set.
# WAMIWA_DEV_FIXED_OTP=123456
# WAMIWA_UPLOAD_DIR=./uploads                   # where uploaded photos, videos and documents are kept

# --- Third-party keys (PRD section 19) ---------------------------------------------------------
# NOT USED YET. Every provider below still runs on a built-in sandbox, so the app works with these
# blank. A key only takes effect once its live adapter is written and wired in app/container.py.
# YouVerify: ID checks, face matching and its live check (ON-05). Cowork dashboard > Settings > API key / Webhook.
# WAMIWA_YOUVERIFY_API_KEY=            # secret key; server only
# WAMIWA_YOUVERIFY_PUBLIC_MERCHANT_KEY= # safe in the browser: starts the live check
# WAMIWA_YOUVERIFY_ENVIRONMENT=sandbox  # sandbox keys work only with sandbox; live keys need "live"
# Flutterwave: payments and all payouts, Naira in Nigeria and US dollars elsewhere (PY-05).
# Flutterwave dashboard > Settings > API keys. Test keys (FLWSECK_TEST-..., FLWPUBK_TEST-...) use test money.
# WAMIWA_FLUTTERWAVE_SECRET_KEY=        # server only; never in the browser
# WAMIWA_FLUTTERWAVE_PUBLIC_KEY=        # opens the checkout window in the browser
# WAMIWA_FLUTTERWAVE_WEBHOOK_HASH=      # the "secret hash" you set for webhooks in the dashboard
# PayPal: a second way to pay, in US dollars (PY-05). Off until both are set: PayPal then refuses with a
# clear message and people pay through Flutterwave. developer.paypal.com > Apps & Credentials.
# WAMIWA_PAYPAL_CLIENT_ID=              # loads PayPal's buttons in the browser
# WAMIWA_PAYPAL_SECRET=                 # server only; never in the browser
# WAMIWA_PAYPAL_ENVIRONMENT=sandbox     # "live" with live credentials charges real money
# WAMIWA_HEYGEN_API_KEY=               # AI video generation
# WAMIWA_VIDEO_WEBHOOK_SECRET=         # (above) HeyGen job-finished callbacks
# Africa's Talking: SMS codes and alerts, and guardian confirmation calls. Dashboard > Settings > API Key.
# SMS works with the username and key; calls also need the voice number and the callback token. Username
# "sandbox" (with the sandbox app's key) reaches no real phone.
# WAMIWA_AFRICASTALKING_USERNAME=
# WAMIWA_AFRICASTALKING_API_KEY=
# WAMIWA_AFRICASTALKING_SENDER_ID=      # registered sender name, e.g. Wamiwa; blank uses Africa's Talking's default
# WAMIWA_AFRICASTALKING_VOICE_NUMBER=   # your Africa's Talking voice number, e.g. +2342017001234
# WAMIWA_AFRICASTALKING_CALLBACK_TOKEN= # any long random value; on the number in the dashboard set the callback URL
#                                       # to https://<api address>/webhooks/africastalking/voice?token=<this value>
# WAMIWA_VOICE_WEBHOOK_SECRET=         # signed call results on /webhooks/voice; must be set on the live site
# WAMIWA_EMAIL_PROVIDER=resend           # connected: set this and the key to send real email (default: sandbox)
# WAMIWA_EMAIL_API_KEY=                # Resend API key
# WAMIWA_EMAIL_FROM_ADDRESS=no-reply@wamiwa.site
# WAMIWA_MODERATION_API_KEY=           # moderation and sentiment (vendor to choose)
# WAMIWA_WATERMARK_API_KEY=            # invisible video watermark (vendor to choose)
# Wamiwa Agent (also not used yet): link safety, trends, and looking artists up by name
# WAMIWA_LINK_SAFETY_API_KEY=         # scam / phishing link reputation (vendor to choose)
# WAMIWA_TRENDS_API_KEY=              # outside trends by region (vendor to choose)
# WAMIWA_SPOTIFY_CLIENT_ID=           # artist lookup
# WAMIWA_SPOTIFY_CLIENT_SECRET=
# WAMIWA_YOUTUBE_API_KEY=             # artist lookup on YouTube Music
# WAMIWA_APPLE_MUSIC_TEAM_ID=         # artist lookup: your Apple Developer team id
# WAMIWA_APPLE_MUSIC_KEY_ID=          # the MusicKit key's id
# WAMIWA_APPLE_MUSIC_PRIVATE_KEY=     # the .p8 file's contents, in quotes, line breaks written as \n
# Social login for follower checks (ON-07) and Facebook friend import (ON-08):
# WAMIWA_INSTAGRAM_CLIENT_ID=
# WAMIWA_INSTAGRAM_CLIENT_SECRET=
# WAMIWA_TIKTOK_CLIENT_ID=
# WAMIWA_TIKTOK_CLIENT_SECRET=
# WAMIWA_X_CLIENT_ID=
# WAMIWA_X_CLIENT_SECRET=
# WAMIWA_YOUTUBE_CLIENT_ID=
# WAMIWA_YOUTUBE_CLIENT_SECRET=
# WAMIWA_FACEBOOK_CLIENT_ID=
# WAMIWA_FACEBOOK_CLIENT_SECRET=
