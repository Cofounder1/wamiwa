# Copy to .env in the project root. Every setting in app/core/config.py can be overridden with a WAMIWA_ prefix.
WAMIWA_ENV=development
WAMIWA_DATABASE_URL=sqlite+aiosqlite:///./wamiwa.db
WAMIWA_PUBLIC_BASE_URL=https://wamiwa.site      # used in links sent by email and SMS
# Production: postgresql+asyncpg://user:password@host:5432/wamiwa
# WAMIWA_REDIS_URL=redis://localhost:6379/0     # required in production (rate limits, OTPs, cache, job locks)
WAMIWA_JWT_SECRET=change-me-to-at-least-32-random-bytes
WAMIWA_HASH_PEPPER=change-me
WAMIWA_PAYMENT_WEBHOOK_SECRET=change-me
WAMIWA_VOICE_WEBHOOK_SECRET=change-me
WAMIWA_VIDEO_WEBHOOK_SECRET=change-me
WAMIWA_RUN_JOBS=true                            # leave on for the worker that runs scheduled jobs
WAMIWA_SANDBOX_FX_RATE=1500

# --- Third-party keys (PRD section 19) ---------------------------------------------------------
# NOT USED YET. Every provider below still runs on a built-in sandbox, so the app works with these
# blank. A key only takes effect once its live adapter is written and wired in app/container.py.
# WAMIWA_YOUVERIFY_API_KEY=            # ID verification, liveness, face match
# WAMIWA_KORAPAY_SECRET_KEY=           # payments, escrow, bank payouts, account name lookup
# WAMIWA_KORAPAY_PUBLIC_KEY=
# WAMIWA_PAYMENT_WEBHOOK_SECRET=       # (above) must match the secret Korapay signs webhooks with
# WAMIWA_HEYGEN_API_KEY=               # AI video generation
# WAMIWA_VIDEO_WEBHOOK_SECRET=         # (above) HeyGen job-finished callbacks
# WAMIWA_SMS_VOICE_API_KEY=            # SMS OTP and guardian confirmation calls (vendor to choose)
# WAMIWA_VOICE_WEBHOOK_SECRET=         # (above) call-result callbacks
# WAMIWA_EMAIL_PROVIDER=resend           # connected: set this and the key to send real email (default: sandbox)
# WAMIWA_EMAIL_API_KEY=                # Resend API key
# WAMIWA_EMAIL_FROM_ADDRESS=no-reply@wamiwa.site
# WAMIWA_MODERATION_API_KEY=           # moderation and sentiment (vendor to choose)
# WAMIWA_WATERMARK_API_KEY=            # invisible video watermark (vendor to choose)
# Wamiwa Agent (also not used yet): link safety, trends, and looking artists up by name
# WAMIWA_LINK_SAFETY_API_KEY=         # scam / phishing link reputation (vendor to choose)
# WAMIWA_TRENDS_API_KEY=              # outside trends by region (vendor to choose)
# WAMIWA_SPOTIFY_CLIENT_ID=           # artist lookup
# WAMIWA_SPOTIFY_CLIENT_SECRET=
# WAMIWA_YOUTUBE_API_KEY=             # artist lookup on YouTube Music
# WAMIWA_AUDIOMACK_API_KEY=           # artist lookup
# WAMIWA_FX_API_KEY=                   # live USD to NGN rate (source to choose); sandbox uses the fixed rate above
# Social login for follower checks (ON-07) and Facebook friend import (ON-08):
# WAMIWA_INSTAGRAM_CLIENT_ID=
# WAMIWA_INSTAGRAM_CLIENT_SECRET=
# WAMIWA_TIKTOK_CLIENT_ID=
# WAMIWA_TIKTOK_CLIENT_SECRET=
# WAMIWA_X_CLIENT_ID=
# WAMIWA_X_CLIENT_SECRET=
# WAMIWA_YOUTUBE_CLIENT_ID=
# WAMIWA_YOUTUBE_CLIENT_SECRET=
# WAMIWA_FACEBOOK_CLIENT_ID=
# WAMIWA_FACEBOOK_CLIENT_SECRET=
